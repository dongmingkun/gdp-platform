# 云服务器方案：Nginx 反向代理 + waitress（把下面内容放进 /etc/nginx/conf.d/gdp.conf）
#
# 把 gdp.example.com 换成你自己的域名。证书用 certbot 一条命令即可自动申请：
#     sudo apt install certbot python3-certbot-nginx
#     sudo certbot --nginx -d gdp.example.com
#
# 注意：域名指向中国大陆的服务器时，需要先完成 ICP 备案，否则 80/443 会被拦截；
# 指向境外服务器（或使用 Render / Hugging Face 等平台）不需要备案。

server {
    listen 80;
    server_name gdp.example.com;

    # 静态文件交给 Nginx 直接发，省得每个请求都过一遍 Python
    location /static/ {
        alias /srv/gdp-platform/webapp/static/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;          # 导出 CSV 这类请求留足时间
    }

    client_max_body_size 4m;
}
